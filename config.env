# moraine build configuration. Sourced by build.sh (POSIX sh syntax).

# --- Alpine ------------------------------------------------------------------
ALPINE_BRANCH="v3.24"
ALPINE_MIRROR="https://dl-cdn.alpinelinux.org/alpine"
ARCH="x86_64"

# --- Branding ---
MORAINE_VERSION="0.1"
MORAINE_URL="https://github.com/<user>/moraine"

# --- Image -------------------------------------------------------------------
IMAGE_NAME="moraine.img"
ESP_SIZE_MB="64"            # holds one ~25 MB UKI plus room for its .new copy
ROOT_SIZE_MB=""             # empty = auto (content + 25% + 256 MB); grows on first boot
HOSTNAME="moraine"

# Public keys for root over SSH (dropbear). Strongly recommended.
SSH_AUTHORIZED_KEYS="./authorized_keys"
# Root password (console + SSH). "moraine" is the shipped default and makes
# moraine-setup ask for a new one; empty = no password (SSH keys only).
ROOT_PASSWORD="moraine"

# Appended to the kernel command line.
CMDLINE_EXTRA=""            # e.g. "mitigations=off"

# Extra Alpine packages for the image (debug tools etc.), space separated.
EXTRA_PACKAGES=""           # e.g. "htop pciutils vulkan-tools"

# --- Memory ------------------------------------------------------------------
GTT_RESERVE_MB="1024"       # system RAM kept out of the GTT pool
GTT_MB=""                   # fixed GTT size in MiB (overrides the above)

# --- GPU ---------------------------------------------------------------------
CU_UNLOCK_MODE="0"          # amdgpu.bc250_cc_write_mode: 0 = stock 24 CU (safe default), 3 = 40 CU
AMDGPU_DISABLE_CU=""        # WGPs to mask, SE.SH.WGP comma list, e.g. "1.0.3"

# --- llama-server ------------------------------------------------------------
LLAMA_MODEL=""               # empty = choose in moraine-setup (server stays off until then)
LLAMA_HOST="0.0.0.0"
LLAMA_PORT="8080"
LLAMA_CTX="16384"           # empty = let --fit choose
LLAMA_ARGS="-ngl 999 -fa on -np 1 -lm dio --cache-ram 0 -ctk q8_0 -ctv q8_0 --jinja --no-webui"
LLAMA_API_KEY=""

# --- Build host --------------------------------------------------------------
# Parallel jobs for package builds.
JOBS=""                     # empty = nproc
# Extra CA bundle appended to the builder's trust store (for TLS-intercepting
# proxies). Leave empty normally.
EXTRA_CA_BUNDLE=""
